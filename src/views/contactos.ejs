<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Contactos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 font-sans">
     <header class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <img src="/img/Logo.avif" alt="NutriVida Logo" class="h-10 md:h-12">
        <h1 class="text-lg md:text-xl font-bold text-green-800">NutriVida Online</h1>
      </div>

      <!-- Menú Desktop -->
      <nav class="hidden md:flex space-x-1 lg:space-x-4">
        <a href="#inicio" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Inicio</a>
        <a href="#servicios" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Servicios</a>
        <a href="/getPayment" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Pagos</a>
        <a href="/admin/contacts" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Contacto</a>
        <a href="/login" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Login</a>
        <% if (isAdmin) { %>
          <a href="/logout" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Logout</a>
        <% } %>
      </nav>

      <!-- Botón Hamburguesa -->
      <button class="md:hidden text-gray-600 hover:text-green-700 focus:outline-none nav__mobile-toggle" aria-label="Menú">
        <i class="fas fa-bars text-xl"></i>
      </button>
    </div>

    <!-- Menú Mobile (oculto por defecto) -->
    <div class="md:hidden hidden nav__mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
        <a href="#inicio" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Inicio</a>
        <a href="#servicios" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Servicios</a>
        <a href="/getPayment" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Pagos</a>
        <a href="/admin/contacts" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Contacto</a>
        <a href="/login" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Login</a>
        <% if (isAdmin) { %>
          <a href="/logout" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Logout</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center gap-2">
                <i class="fas fa-address-book"></i> Registros de Contacto
            </h1>
            <div class="flex items-center gap-2 mt-4 md:mt-0">
                <span class="text-2xl font-semibold text-blue-600"><%= contacts.length %></span>
                <span class="text-gray-500">Registros</span>
            </div>
        </div>
        
        <!-- Search Form -->
        <form id="filterForm" class="mb-8 w-full max-w-2xl mx-auto">
            <div class="relative">
                <input
                    type="text"
                    id="searchInput"
                    placeholder="Buscar por nombre o correo..."
                    class="w-full px-4 py-3 pr-10 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 placeholder-gray-400 text-gray-700"
                />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
            </div>
        </form>

        <!-- Contacts Container -->
        <div id="contactsContainer" class="bg-white rounded-xl shadow-sm overflow-hidden">
            <% if (contacts.length > 0) { %>
                <!-- Table for larger screens -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr class="text-left text-gray-500 text-sm font-medium">
                                <th class="px-6 py-3">Nombre</th>
                                <th class="px-6 py-3">Email</th>
                                <th class="px-6 py-3">Comentario</th>
                                <th class="px-6 py-3">País</th>
                                <th class="px-6 py-3">IP</th>
                                <th class="px-6 py-3">Fecha</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <% contacts.forEach(contact => { %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="flex-shrink-0 h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-medium">
                                                <%= contact.nombre.charAt(0).toUpperCase() %>
                                            </div>
                                            <span class="font-medium text-gray-900"><%= contact.nombre %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <a href="mailto:<%= contact.email %>" class="text-blue-600 hover:underline"><%= contact.email %></a>
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        <%= contact.comentario.substring(0, 50) %><%= contact.comentario.length > 50 ? '...' : '' %>
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        <%= contact.pais %>
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        <%= contact.ip %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm text-gray-500">
                                            <div><%= new Date(contact.createdAt).toLocaleDateString() %></div>
                                            <div class="text-xs"><%= new Date(contact.createdAt).toLocaleTimeString() %></div>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Cards for mobile -->
                <div class="md:hidden grid grid-cols-1 gap-4 p-4">
                    <% contacts.forEach(contact => { %>
                        <div class="bg-white rounded-lg shadow p-4 border border-gray-100">
                            <div class="flex justify-between items-start mb-3">
                                <div class="flex items-center gap-3">
                                    <div class="flex-shrink-0 h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-medium">
                                        <%= contact.nombre.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <h3 class="font-medium text-gray-900"><%= contact.nombre %></h3>
                                        <a href="mailto:<%= contact.email %>" class="text-sm text-blue-600 hover:underline"><%= contact.email %></a>
                                    </div>
                                </div>
                                <span class="text-xs text-gray-500">
                                    <%= new Date(contact.createdAt).toLocaleDateString() %>
                                </span>
                            </div>
                            
                            <div class="space-y-2 text-sm">
                                <div>
                                    <span class="font-medium text-gray-700">Comentario:</span>
                                    <p class="text-gray-600"><%= contact.comentario.substring(0, 50) %><%= contact.comentario.length > 50 ? '...' : '' %></p>
                                </div>
                                <div class="flex justify-between">
                                    <div>
                                        <span class="font-medium text-gray-700">País:</span>
                                        <span class="text-gray-600"><%= contact.pais %></span>
                                    </div>
                                    <div>
                                        <span class="font-medium text-gray-700">IP:</span>
                                        <span class="text-gray-600"><%= contact.ip %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <!-- Empty state -->
                <div class="text-center py-12">
                    <div class="mx-auto w-48 h-48 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                        <i class="fas fa-inbox text-4xl text-gray-400"></i>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-1">No hay registros</h3>
                    <p class="text-gray-500">No hay registros de contactos disponibles</p>
                </div>
            <% } %>
        </div>
    </div>
      <script>
  // Toggle del menú móvil
  document.querySelector('.nav__mobile-toggle').addEventListener('click', function() {
    const mobileMenu = document.querySelector('.nav__mobile-menu');
    mobileMenu.classList.toggle('hidden');
    
    // Cambiar ícono entre hamburguesa y X
    const icon = this.querySelector('i');
    if (mobileMenu.classList.contains('hidden')) {
      icon.classList.remove('fa-times');
      icon.classList.add('fa-bars');
    } else {
      icon.classList.remove('fa-bars');
      icon.classList.add('fa-times');
    }
  });
</script>
    <script src='/js/filter.js'></script>
</body>
</html>