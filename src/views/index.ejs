<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:title" content="<%=title%>">
    <meta property="og:description" content="<%=description%>">
    <meta property="og:image" content="<%=imageUrl%>">
    <meta property="og:url" content="<%=pageUrl%>">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/scripts/main.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="icon" href="/img/logo.avif" type="image/x-icon">
    <script src="/js/alertConfig.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2988ZTXT45"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2988ZTXT45');
  </script>
</head>
<body>
<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <img src="/img/Logo.avif" alt="NutriVida Logo" class="h-10 md:h-12">
        <h1 class="text-lg md:text-xl font-bold text-green-800">NutriVida Online</h1>
      </div>

      <!-- Menú Desktop -->
      <nav class="hidden md:flex space-x-1 lg:space-x-4">
        <a href="#inicio" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Inicio</a>
        <a href="#servicios" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Servicios</a>
        <a href="/getPayment" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Pagos</a>
        <a href="/admin/contacts" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Contacto</a>
        <a href="/login" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Login</a>
        <% if (isAdmin) { %>
          <a href="/logout" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Logout</a>
        <% } %>
      </nav>

      <!-- Botón Hamburguesa -->
      <button class="md:hidden text-gray-600 hover:text-green-700 focus:outline-none nav__mobile-toggle" aria-label="Menú">
        <i class="fas fa-bars text-xl"></i>
      </button>
    </div>

    <!-- Menú Mobile (oculto por defecto) -->
    <div class="md:hidden hidden nav__mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
        <a href="#inicio" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Inicio</a>
        <a href="#servicios" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Servicios</a>
        <a href="/getPayment" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Pagos</a>
        <a href="/admin/contacts" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Contacto</a>
        <a href="/login" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Login</a>
        <% if (isAdmin) { %>
          <a href="/logout" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-green-50 hover:text-green-700 transition">Logout</a>
        <% } %>
      </div>
    </div>
  </div>
</header>

<main class="main">
    <section id="inicio" class="hero">
        <div class="hero__container">
            <div class="hero__content">
                <h2 class="hero__title">Nutrición Personalizada Desde la comodidad de Tu Hogar</h2>
                <p class="hero__text">Planificación alimentaria adaptada a tus necesidades, objetivos y estilo de vida con seguimiento profesional online.</p>
                <a href="#contacto" class="hero__button">¡Empieza Hoy!</a>
            </div>
            <div class="hero__image-container">
                <img src="/img/frutas.avif" alt="Comida saludable" class="hero__image">
            </div>
        </div>
    </section>

    <section id="servicios" class="services">
        <div class="section__header">
            <h2 class="section__title">Nuestros Servicios</h2>
            <p class="section__subtitle">Programas personalizados para cada necesidad</p>
        </div>
        <div class="services__container">
            <div class="service__card">
                <div class="service__icon">
                    <i class="fas fa-weight"></i>
                </div>
                <h3 class="service__title">Control de Peso</h3>
                <p class="service__description">Plan nutricional para pérdida, aumento o mantenimiento de peso de forma saludable.</p>
                <div class="service__price">
                    <span class="price__amount">$99</span>
                    <span class="price__period">/mes</span>
                </div>
                <a href="/payment" class="service__btn">Adquirir</a>
            </div>
            <div class="service__card">
                <div class="service__icon">
                    <i class="fas fa-running"></i>
                </div>
                <h3 class="service__title">Nutrición Deportiva</h3>
                <p class="service__description">Optimiza tu rendimiento deportivo con alimentación específica para tus entrenamientos.</p>
                <div class="service__price">
                    <span class="price__amount">$129</span>
                    <span class="price__period">/mes</span>
                </div>
                <a href="/payment" class="service__btn">Adquirir</a>
            </div>
            <div class="service__card">
                <div class="service__icon">
                    <i class="fas fa-heartbeat"></i>
                </div>
                <h3 class="service__title">Salud Metabólica</h3>
                <p class="service__description">Manejo nutricional de diabetes, hipertensión, colesterol alto y otras condiciones.</p>
                <div class="service__price">
                    <span class="price__amount">$119</span>
                    <span class="price__period">/mes</span>
                </div>
                <a href="/payment" class="service__btn">Adquirir</a>
            </div>
            <div class="service__card">
                <div class="service__icon">
                    <i class="fas fa-baby"></i>
                </div>
                <h3 class="service__title">Nutrición Familiar</h3>
                <p class="service__description">Planes para embarazo, niños, adolescentes y toda la familia con recetas prácticas.</p>
                <div class="service__price">
                    <span class="price__amount">$149</span>
                    <span class="price__period">/mes</span>
                </div>
                <a href="/payment" class="service__btn">Adquirir</a>
            </div>
        </div>
    </section>


    <section id="beneficios" class="benefits">
        <div class="section__header">
            <h2 class="section__title">Beneficios de la Consulta Online</h2>
            <p class="section__subtitle">Por qué elegir nutrición a distancia</p>
        </div>
        <div class="benefits__container">
            <div class="benefits__content">
                <ul class="benefits__list">
                    <li class="benefit__item">
                        <i class="fas fa-check-circle benefit__icon"></i>
                        <span class="benefit__text">Ahorra tiempo al evitar desplazamientos</span>
                    </li>
                    <li class="benefit__item">
                        <i class="fas fa-check-circle benefit__icon"></i>
                        <span class="benefit__text">Accesible desde cualquier lugar con internet</span>
                    </li>
                    <li class="benefit__item">
                        <i class="fas fa-check-circle benefit__icon"></i>
                        <span class="benefit__text">Horarios flexibles adaptados a tu rutina</span>
                    </li>
                    <li class="benefit__item">
                        <i class="fas fa-check-circle benefit__icon"></i>
                        <span class="benefit__text">Seguimiento constante mediante plataforma digital</span>
                    </li>
                    <li class="benefit__item">
                        <i class="fas fa-check-circle benefit__icon"></i>
                        <span class="benefit__text">Recetas y listas de compra personalizadas</span>
                    </li>
                    <li class="benefit__item">
                        <i class="fas fa-check-circle benefit__icon"></i>
                        <span class="benefit__text">Acceso a material educativo exclusivo</span>
                    </li>
                </ul>
            </div>
            <div class="benefits__image-container">
                <img src="/img/beneficios.avif" alt="Beneficios consulta online" class="benefits__image">
            </div>
        </div>
    </section>

    <section id="sobre-mi" class="about">
        <div class="about__container">
            <div class="about__image-container">
                <img src="/img/laura.avif" alt="Nutricionista profesional" class="about__image">
            </div>
            <div class="about__content">
                <h2 class="section__title">Sobre Mí</h2>
                <p class="about__text">Soy Laura Martínez, nutricionista titulada con más de 10 años de experiencia en consulta presencial y online. Especializada en nutrición clínica y deportiva.</p>
                <p class="about__text">Mi enfoque se basa en crear planes alimenticios realistas, flexibles y adaptados a las necesidades individuales de cada paciente, promoviendo una relación saludable con la comida.</p>
                <div class="about__credentials">
                    <div class="credential__item">
                        <i class="fas fa-graduation-cap credential__icon"></i>
                        <span class="credential__text">Licenciada en Nutrición y Dietética</span>
                    </div>
                    <div class="credential__item">
                        <i class="fas fa-certificate credential__icon"></i>
                        <span class="credential__text">Máster en Nutrición Deportiva</span>
                    </div>
                    <div class="credential__item">
                        <i class="fas fa-users credential__icon"></i>
                        <span class="credential__text">+1,500 pacientes atendidos</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="testimonios" class="testimonials">
        <div class="section__header">
            <h2 class="section__title">Testimonios</h2>
            <p class="section__subtitle">Lo que dicen nuestros pacientes</p>
        </div>
        <div class="testimonials__container">
            <div class="testimonial__card">
                <div class="testimonial__content">
                    <p class="testimonial__text">"Perdí 15 kg en 6 meses con un plan adaptado a mi ritmo de vida. Lo mejor es que no tuve que dejar mis comidas favoritas, solo aprender a balancearlas."</p>
                </div>
                <div class="testimonial__author">
                    <img src="/img/carlos rodriguezzz.avif" alt="Cliente 1" class="author__image">
                    <div class="author__info">
                        <h4 class="author__name">Carlos Rodríguez</h4>
                        <p class="author__detail">32 años, Consultor TI</p>
                    </div>
                </div>
            </div>
            <div class="testimonial__card">
                <div class="testimonial__content">
                    <p class="testimonial__text">"Como deportista amateur, noté una gran mejora en mi rendimiento después de ajustar mi alimentación. Las consultas online son super prácticas."</p>
                </div>
                <div class="testimonial__author">
                    <img src="/img/ana-gomez.avif" alt="Cliente 2" class="author__image">
                    <div class="author__info">
                        <h4 class="author__name">Ana Gómez</h4>
                        <p class="author__detail">28 años, Triatleta</p>
                    </div>
                </div>
            </div>
            <div class="testimonial__card">
                <div class="testimonial__content">
                    <p class="testimonial__text">"Logré controlar mi diabetes tipo 2 y reducir mi medicación. Las videollamadas mensuales me ayudaron a mantener la motivación."</p>
                </div>
                <div class="testimonial__author">
                    <img src="/img/marthasan.avif" alt="Cliente 3" class="author__image">
                    <div class="author__info">
                        <h4 class="author__name">Marta Sánchez</h4>
                        <p class="author__detail">56 años, Jubilada</p>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <section id="contacto" class="contact">
        <div class="section__header">
            <h2 class="section__title">Contacto</h2>
            <p class="section__subtitle">Agenda tu primera consulta gratuita</p>
        </div>
        <div class="contact__container">
            <div class="contact__form-container">
                <form id='formulario' class="contact__form" id="form__contact">
                    <div class="form__group">
                        <label for="name" class="form__label">Nombre completo</label>
                        <input type="text" id="nombre" name="nombre" class="form__input" required>
                    </div>
                    <div class="form__group">
                        <label for="email" class="form__label">Correo electrónico</label>
                        <input type="email" id="email" name="email" class="form__input" required>
                    </div>

                    <div class="form__group">
                        <label for="message" class="form__label">Mensaje</label>
                        <textarea id="comentario" name="comentario" rows="4" class="form__textarea"></textarea>
                    </div>
                    
                    <!-- reCAPTCHA -->
                    <div class="g-recaptcha" data-sitekey="<%=sitioKey%>"></div>
                    <button type="submit" class="form__button">Enviar Mensaje</button>
                </form>
            </div>
            <div class="contact__info">
                <h3 class="contact__info-title">Información de Contacto</h3>
                <div class="info__item">
                    <i class="fas fa-envelope info__icon"></i>
                    <span class="info__text">consultas@nutrividaonline.com</span>
                </div>
                <div class="info__item">
                    <i class="fas fa-phone-alt info__icon"></i>
                    <span class="info__text">+58 4124617355</span>
                </div>
                <div class="info__item">
                    <i class="fas fa-clock info__icon"></i>
                    <span class="info__text">Lunes a Viernes: 9:00 - 19:00</span>
                </div>
                <div class="contact__social">
                    <h4 class="social__title">Síguenos en redes</h4>
                    <div class="social__links">
                        <a href="https://www.facebook.com/" class="social__link"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://www.instagram.com/" class="social__link"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="footer__container">
        <div class="footer__logo">
            <img src="/img/logo.avif" alt="NutriVida Logo" class="footer__logo-image">
            <h3 class="footer__logo-text">NutriVida Online</h3>
        </div>
        <div class="footer__links">
            <div class="footer__column">
                <h4 class="footer__title">Servicios</h4>
                <ul class="footer__list">
                    <li class="footer__item"><a href="#" class="footer__link">Control de Peso</a></li>
                    <li class="footer__item"><a href="#" class="footer__link">Nutrición Deportiva</a></li>
                    <li class="footer__item"><a href="#" class="footer__link">Salud Metabólica</a></li>
                    <li class="footer__item"><a href="#" class="footer__link">Nutrición Familiar</a></li>
                </ul>
            </div>
            <div class="footer__column">
                <h4 class="footer__title">Enlaces</h4>
                <ul class="footer__list">
                    <li class="footer__item"><a href="#" class="footer__link">Blog</a></li>
                    <li class="footer__item"><a href="#" class="footer__link">Recetas</a></li>
                    <li class="footer__item"><a href="#" class="footer__link">Preguntas Frecuentes</a></li>
                    <li class="footer__item"><a href="#" class="footer__link">Política de Privacidad</a></li>
                </ul>
            </div>
            <div class="footer__column">
                <h4 class="footer__title">Contacto</h4>
                <ul class="footer__list">
                    <li class="footer__item"><a href="mailto:consultas@nutrividaonline.com" class="footer__link">consultas@nutrividaonline.com</a></li>
                    <li class="footer__item"><a href="tel:+34123456789" class="footer__link">+58 4124617355</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="footer__bottom">
        <p class="footer__copyright">© 2025 NutriVida Online. Todos los derechos reservados.</p>
    </div>
</footer>
<script src='/js/fetch.js'></script>
<script>
  // Toggle del menú móvil
  document.querySelector('.nav__mobile-toggle').addEventListener('click', function() {
    const mobileMenu = document.querySelector('.nav__mobile-menu');
    mobileMenu.classList.toggle('hidden');
    
    // Cambiar ícono entre hamburguesa y X
    const icon = this.querySelector('i');
    if (mobileMenu.classList.contains('hidden')) {
      icon.classList.remove('fa-times');
      icon.classList.add('fa-bars');
    } else {
      icon.classList.remove('fa-bars');
      icon.classList.add('fa-times');
    }
  });
</script>
</body>
</html>